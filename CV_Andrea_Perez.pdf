<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 440" width="1280" height="440" font-family="'Segoe UI', system-ui, sans-serif">
  <defs>
    <linearGradient id="title" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#a99bff"/>
      <stop offset="1" stop-color="#4fd6c9"/>
    </linearGradient>
    <linearGradient id="avatar" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8b7bff"/>
      <stop offset="1" stop-color="#4fd6c9"/>
    </linearGradient>
    <radialGradient id="b1"><stop offset="0" stop-color="#8b7bff" stop-opacity="0.9"/><stop offset="1" stop-color="#8b7bff" stop-opacity="0"/></radialGradient>
    <radialGradient id="b2"><stop offset="0" stop-color="#4fd6c9" stop-opacity="0.85"/><stop offset="1" stop-color="#4fd6c9" stop-opacity="0"/></radialGradient>
    <radialGradient id="b3"><stop offset="0" stop-color="#ff8fc7" stop-opacity="0.7"/><stop offset="1" stop-color="#ff8fc7" stop-opacity="0"/></radialGradient>
    <filter id="blur"><feGaussianBlur stdDeviation="60"/></filter>
    <clipPath id="round"><rect x="0" y="0" width="1280" height="440" rx="26"/></clipPath>
  </defs>

  <g clip-path="url(#round)">
    <!-- Wallpaper -->
    <rect width="1280" height="440" fill="#0b0d1a"/>
    <!-- Aurora blobs -->
    <circle cx="230" cy="120" r="300" fill="url(#b1)" filter="url(#blur)">
      <animate attributeName="cx" values="230;330;230" dur="14s" repeatCount="indefinite"/>
    </circle>
    <circle cx="1080" cy="360" r="280" fill="url(#b2)" filter="url(#blur)">
      <animate attributeName="cy" values="360;300;360" dur="18s" repeatCount="indefinite"/>
    </circle>
    <circle cx="720" cy="240" r="220" fill="url(#b3)" filter="url(#blur)">
      <animate attributeName="cx" values="720;640;720" dur="20s" repeatCount="indefinite"/>
    </circle>

    <!-- Menu bar -->
    <rect x="0" y="0" width="1280" height="32" fill="#181a2d" fill-opacity="0.55"/>
    <text x="24" y="21" fill="#f4f5fb" font-size="13" font-weight="600">Andrea Pérez</text>
    <text x="110" y="21" fill="#f4f5fb" fill-opacity="0.6" font-size="13">Acerca de   Experiencia   Notas   Contacto</text>
    <circle cx="1150" cy="16" r="4" fill="#45e08a"/>
    <text x="1162" y="21" fill="#f4f5fb" fill-opacity="0.7" font-size="12">Disponible</text>
    <text x="1240" y="21" fill="#f4f5fb" fill-opacity="0.85" font-size="12" text-anchor="end">12:30</text>

    <!-- Glass "Notas" window -->
    <g transform="translate(90,96)">
      <rect width="440" height="250" rx="16" fill="#20223a" fill-opacity="0.55" stroke="#ffffff" stroke-opacity="0.2"/>
      <rect width="440" height="38" rx="16" fill="#ffffff" fill-opacity="0.05"/>
      <circle cx="22" cy="19" r="6" fill="#ff5f57"/>
      <circle cx="42" cy="19" r="6" fill="#febc2e"/>
      <circle cx="62" cy="19" r="6" fill="#28c840"/>
      <text x="90" y="23" fill="#f4f5fb" fill-opacity="0.6" font-size="12">Notas — Léeme</text>
      <!-- sidebar -->
      <rect x="0" y="38" width="140" height="212" fill="#000000" fill-opacity="0.18"/>
      <rect x="14" y="58" width="112" height="26" rx="7" fill="#8b7bff" fill-opacity="0.25"/>
      <text x="24" y="75" fill="#f4f5fb" font-size="11">Perfil</text>
      <text x="24" y="105" fill="#f4f5fb" fill-opacity="0.6" font-size="11">Lo destacado</text>
      <text x="24" y="130" fill="#f4f5fb" fill-opacity="0.6" font-size="11">Competencias</text>
      <text x="24" y="228" fill="#4fd6c9" font-size="11">Descargar CV ↓</text>
      <!-- body -->
      <text x="164" y="70" fill="#f4f5fb" font-size="15" font-weight="600">Quién soy</text>
      <rect x="164" y="86" width="250" height="8" rx="4" fill="#f4f5fb" fill-opacity="0.22"/>
      <rect x="164" y="104" width="230" height="8" rx="4" fill="#f4f5fb" fill-opacity="0.16"/>
      <rect x="164" y="122" width="245" height="8" rx="4" fill="#f4f5fb" fill-opacity="0.16"/>
      <rect x="164" y="140" width="180" height="8" rx="4" fill="#f4f5fb" fill-opacity="0.16"/>
      <text x="164" y="178" fill="#4fd6c9" font-size="12" font-style="italic">"Solo optimizo procesos."</text>
    </g>

    <!-- Title block -->
    <text x="600" y="170" fill="url(#title)" font-size="72" font-weight="700" letter-spacing="-1">AndreaOS</text>
    <text x="602" y="208" fill="#f4f5fb" font-size="19" font-weight="500">Product Designer</text>
    <text x="602" y="234" fill="#f4f5fb" fill-opacity="0.6" font-size="15">Product Manager · Project Manager · UX/UI</text>
    <rect x="602" y="256" width="230" height="34" rx="17" fill="#8b7bff" fill-opacity="0.16" stroke="#8b7bff" stroke-opacity="0.4"/>
    <text x="620" y="278" fill="#cfc7ff" font-size="13">✦ Portfolio interactivo · vanilla JS</text>

    <!-- Dock -->
    <g transform="translate(490,378)">
      <rect width="300" height="52" rx="18" fill="#181a2d" fill-opacity="0.6" stroke="#ffffff" stroke-opacity="0.15"/>
      <rect x="14" y="10" width="34" height="34" rx="9" fill="#f4f5fb"/>
      <rect x="58" y="10" width="34" height="34" rx="9" fill="#ffb35c"/>
      <rect x="102" y="10" width="34" height="34" rx="9" fill="#fff2b0"/>
      <rect x="146" y="10" width="34" height="34" rx="9" fill="#64b6ff"/>
      <rect x="196" y="10" width="34" height="34" rx="9" fill="#0a66c2"/>
      <rect x="240" y="10" width="34" height="34" rx="9" fill="#ff7a7a"/>
    </g>
  </g>
</svg>
